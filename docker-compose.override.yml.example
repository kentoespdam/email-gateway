# Template override untuk development lokal
# Salin file ini ke docker-compose.override.yml
# Docker Compose akan otomatis menggabungkannya saat menjalankan `docker compose up`
services:
  postgres:
    ports:
      - "${POSTGRES_PORT:-5432}:5432"

  redis:
    ports:
      - "${REDIS_PORT:-6379}:6379"
